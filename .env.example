# LLM Provider Configuration
# Optional: Set an API key for live LLM generation (e.g. Google Gemini, OpenAI, or LiteLLM)
# If not set, the agent operates in fully grounded offline deterministic mode.
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=offline  # "offline", "gemini", "openai"
LLM_MODEL=gemini-2.5-flash

# Application Settings
DEBUG_MODE=false
SNAPSHOT_AT=2026-08-15T12:00:00Z
